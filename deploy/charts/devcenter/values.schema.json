{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "devcenter", "components", "substrate"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "publicOrigin", "imagePullSecrets", "podLabels"],
      "properties": {
        "tenantId": {"type": "string"},
        "publicOrigin": {"type": "string"},
        "imagePullSecrets": {"type": "array", "items": {"type": "string"}},
        "podLabels": {"type": "object"}
      }
    },
    "devcenter": {"type": "object"},
    "ingress": {"type": "object"},
    "components": {"type": "object"},
    "connectorsCatalogBundle": {"type": "object"},
    "substrate": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressNamespaceSelector", "ingressPodSelector", "allowExternalHttps", "extraEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceSelector": {"type": "object"},
        "ingressPodSelector": {"type": "object"},
        "allowExternalHttps": {"type": "boolean"},
        "extraEgress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "serviceMonitor": {"type": "object"},
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault"],
      "properties": {
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "kubernetesApiCidrs", "tls", "seal", "backup"],
          "properties": {
            "enabled": {"type": "boolean"},
            "kubernetesApiCidrs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["certManager", "existingSecret"],
              "properties": {
                "certManager": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["enabled", "duration", "renewBefore"],
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "duration": {"type": "string", "minLength": 1},
                    "renewBefore": {"type": "string", "minLength": 1}
                  }
                },
                "existingSecret": {"type": "string"}
              }
            },
            "seal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "awsKms"],
              "properties": {
                "provider": {"const": "awskms"},
                "awsKms": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["region", "keyId"],
                  "properties": {
                    "region": {"type": "string"},
                    "keyId": {"type": "string"}
                  }
                }
              }
            },
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "schedule", "bucket", "prefix", "region", "serviceAccount", "image", "retentionDays", "resources"],
              "properties": {
                "enabled": {"type": "boolean"},
                "schedule": {"type": "string", "minLength": 1},
                "bucket": {"type": "string"},
                "prefix": {"type": "string", "minLength": 1},
                "region": {"type": "string"},
                "serviceAccount": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["annotations"],
                  "properties": {"annotations": {"type": "object"}}
                },
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repository", "digest", "pullPolicy"],
                  "properties": {
                    "repository": {"type": "string"},
                    "digest": {"type": "string"},
                    "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
                  }
                },
                "retentionDays": {"type": "integer", "minimum": 1},
                "resources": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "vault": {"type": "object"}
  }
}
