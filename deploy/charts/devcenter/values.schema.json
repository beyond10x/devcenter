{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "devcenter", "components", "secrets", "substrate"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "publicOrigin", "imagePullSecrets", "podLabels"],
      "properties": {
        "tenantId": { "type": "string" },
        "publicOrigin": { "type": "string" },
        "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
        "podLabels": { "type": "object" }
      }
    },
    "devcenter": { "type": "object" },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "annotations",
        "tls",
        "connectorSetupRoutes",
        "identityCliRoutes",
        "connectorClientApi",
        "connectorAdminRoutes",
        "connectorDocs"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "connectorSetupRoutes": { "$ref": "#/$defs/routeToggle" },
        "identityCliRoutes": { "$ref": "#/$defs/routeToggle" },
        "connectorClientApi": { "$ref": "#/$defs/routeToggle" },
        "connectorAdminRoutes": { "$ref": "#/$defs/routeToggle" },
        "connectorDocs": { "$ref": "#/$defs/routeToggle" }
      }
    },
    "components": { "type": "object" },
    "connectorsCatalogBundle": { "type": "object" },
    "substrate": { "type": "object" },
    "secrets": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressNamespaceSelector",
        "ingressPodSelector",
        "allowExternalHttps",
        "extraEgress"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "type": "object" },
        "ingressPodSelector": { "type": "object" },
        "allowExternalHttps": { "type": "boolean" },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceMonitor": { "type": "object" }
  },
  "$defs": {
    "routeToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
