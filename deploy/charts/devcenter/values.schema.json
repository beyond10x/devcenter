{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "devcenter", "components", "connectorsGitFetch", "connectorsKubernetesAccess", "secrets", "substrate"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "publicOrigin", "imagePullSecrets", "podLabels"],
      "properties": {
        "tenantId": { "type": "string" },
        "publicOrigin": { "type": "string" },
        "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
        "podLabels": { "type": "object" }
      }
    },
    "devcenter": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "exchangeCallerId": { "type": "string" },
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "display_name"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "display_name": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "annotations",
        "tls",
        "connectorSetupRoutes",
        "identityCliRoutes",
        "connectorClientApi",
        "connectorAdminRoutes",
        "connectorDocs"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "connectorSetupRoutes": { "$ref": "#/$defs/routeToggle" },
        "identityCliRoutes": { "$ref": "#/$defs/routeToggle" },
        "connectorClientApi": { "$ref": "#/$defs/routeToggle" },
        "connectorAdminRoutes": { "$ref": "#/$defs/routeToggle" },
        "connectorDocs": { "$ref": "#/$defs/routeToggle" }
      }
    },
    "components": { "type": "object" },
    "connectorsCatalogBundle": { "type": "object" },
    "connectorsGitFetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceName", "port", "listenPort", "tls", "trustRoots"],
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "port": { "const": 443 } } }
        }
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "listenPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "certificateKey", "privateKeyKey"],
          "properties": {
            "existingSecret": { "type": "string" },
            "certificateKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "trustRoots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "connectorsKubernetesAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "namespaces", "apiServerCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "apiServerCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 49 }
        }
      }
    },
    "substrate": { "type": "object" },
    "secrets": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressNamespaceSelector",
        "ingressPodSelector",
        "allowExternalHttps",
        "extraEgress"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "type": "object" },
        "ingressPodSelector": { "type": "object" },
        "allowExternalHttps": { "type": "boolean" },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceMonitor": { "type": "object" }
  },
  "$defs": {
    "routeToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
