{
  "name": "devcenter-frontend",
  "version": "0.8.20",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "review": "vite --mode review --host 127.0.0.1 --port 4173",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build --force",
    "generate:types": "openapi-typescript ../openapi.json -o src/api/schema.gen.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:review": "playwright test --config playwright.review.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm check:generated && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@b10x/agentide-ui": "git+https://github.com/beyond10x/agentide.git#6ae129950348344b4fc3ea54c44d0167038ff31e",
    "@b10x/phone-widget": "git+https://github.com/beyond10x/widgets.git#3a33b45a3dbdb901a13faf8ef2ef5171ba04cb33&path:/widgets/phone/widget",
    "@b10x/service-console-vue": "git+https://github.com/beyond10x/service-sdk.git#084defb7bf2960b9888db42feb9f009c1a78d4e4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@lucide/vue": "1.38.0",
    "markdown-it": "15.0.1",
    "monaco-editor": "0.56.0",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "27.0.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11",
    "ws": "8.21.3"
  }
}
